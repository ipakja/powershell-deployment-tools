DirectoryIndex index.html

RewriteEngine On
RewriteBase /

# 1. Canonical host: HTTPS + non-www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.boksitsupport\.ch$ [NC]
RewriteRule ^ https://boksitsupport.ch%{REQUEST_URI} [R=301,L]

# 2. Legacy paths (older deployments, extensionless)
RewriteRule ^$ /de/ [R=301,L]
RewriteRule ^rechtliches/?$ /de/legal/ [R=301,L]
RewriteRule ^packages/?$ /de/#services [R=301,L,NE]
RewriteRule ^packages-en/?$ /en/#services [R=301,L,NE]
RewriteRule ^en/?$ /en/ [R=301,L]
RewriteRule ^index-en/?$ /en/ [R=301,L]

# 3. Legacy filenames (.html) – falls alte Dateien noch auf dem Server liegen
RewriteRule ^packages\.html$ /de/#services [R=301,L,NE]
RewriteRule ^packages-en\.html$ /en/#services [R=301,L,NE]
RewriteRule ^index-en\.html$ /en/ [R=301,L]
RewriteRule ^index_en\.html$ /en/ [R=301,L]
RewriteRule ^en\.html$ /en/ [R=301,L]

# 4. Clean URLs -> canonical .html
RewriteRule ^services(?:\.html)?/?$ /de/#services [R=301,L,NE]
RewriteRule ^it-matrix(?:\.html)?/?$ /de/#services [R=301,L,NE]
RewriteRule ^kontakt(?:\.html)?/?$ /de/#contact [R=301,L,NE]
RewriteRule ^services-en(?:\.html)?/?$ /en/#services [R=301,L,NE]
RewriteRule ^it-matrix-en(?:\.html)?/?$ /en/#services [R=301,L,NE]
RewriteRule ^kontakt-en(?:\.html)?/?$ /en/#contact [R=301,L,NE]

ErrorDocument 404 /404.html
ErrorDocument 500 /500.html
